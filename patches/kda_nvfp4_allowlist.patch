+def _kdev_extra_shapes() -> frozenset:
+    """kdev 14-oct: extra (m, k, n) qualified on RTX PRO 6000 (SM120) for dense
+    Qwen3.x 27B MLPs (gate_up 5120->34816, down 17408->5120): KDA 85-89 % of DRAM
+    bandwidth vs flashinfer cutlass 50-70 %. Same kernel, the allowlist is the only
+    gate. SGLANG_KDEV_KDA_NVFP4_KN="KxN,KxN" (empty disables), _MAX_M (default 16)."""
+    import os
+
+    kn = os.environ.get("SGLANG_KDEV_KDA_NVFP4_KN", "5120x34816,17408x5120")
+    max_m = int(os.environ.get("SGLANG_KDEV_KDA_NVFP4_MAX_M", "16"))
+    pairs = [tuple(int(v) for v in p.lower().split("x")) for p in kn.split(",") if p.strip()]
+    return frozenset((m, k, n) for m in range(1, max_m + 1) for k, n in pairs)
+
+
+_SUPPORTED_SHAPES = _SUPPORTED_SHAPES | _kdev_extra_shapes()
+_LOGGED_SHAPES: set = set()
+
